{
  "manifestVersion": 1,
  "id": "evotalks.gestao-imoveis",
  "version": "0.22.1",
  "name": "Gerenciamento de Imóveis",
  "description": "Gestão de Imóveis, Locados, Chamados e Prestadores, com campos internos, histórico de autoria e cockpit de manutenção no atendimento.",
  "author": {
    "name": "Evotalks / Cromyk"
  },
  "config": [
    {
      "key": "portalUrl",
      "label": "URL do portal (backend)",
      "type": "url",
      "help": "Ex.: https://gestao-imoveis.evotalks.io — vazio faz as telas gravarem só no navegador de quem usa, sem chegar à IA."
    },
    {
      "key": "portalToken",
      "label": "Token do portal",
      "type": "secret",
      "help": "O mesmo MCP_TOKEN do portal. Sem ele as telas não conseguem ler nem gravar no banco que a IA consulta."
    },
    {
      "key": "marca",
      "label": "Marca do catálogo (brand)",
      "type": "string",
      "default": "WILLIAM IMÓVEIS BOULEVARD",
      "help": "Filtra o catálogo por este campo brand. Vazio traz todos os produtos."
    },
    {
      "key": "prefixoCodigo",
      "label": "Prefixo do código a esconder",
      "type": "string",
      "default": "535",
      "help": "O código do site não mostra o prefixo da imobiliária (5350060 vira 0060)."
    },
    {
      "key": "rotulo",
      "label": "Como chamar o item do catálogo",
      "type": "string",
      "default": "imóvel",
      "help": "Usado nos textos das telas."
    },
    {
      "key": "cockpitAbreChamado",
      "label": "Permitir abrir chamado no atendimento",
      "type": "boolean",
      "default": false,
      "help": "Habilita a abertura de chamados pelo cockpit, sempre após confirmação. Desligado permite apenas consultar."
    },
    {
      "key": "modoDemonstracao",
      "label": "Demonstração de manutenção",
      "type": "boolean",
      "default": false,
      "help": "Exibe dados sintéticos de manutenção sem rede nem gravação no portal. Desative para consultar dados reais."
    }
  ],
  "contributions": [
    {
      "id": "gestao-imoveis",
      "type": "topMenu",
      "title": "Gerenciamento de Imóveis",
      "icon": "app/icone-casa.svg",
      "visibility": {
        "userTypes": [
          0,
          1,
          2
        ]
      },
      "presentation": {
        "mode": "menu"
      },
      "items": [
        {
          "id": "gi-imoveis",
          "title": "Imóveis",
          "icon": "icon-far-building",
          "url": "app/imoveis.html",
          "presentation": {
            "mode": "fullscreen"
          }
        },
        {
          "id": "gi-locados",
          "title": "Locados",
          "icon": "icon-far-key",
          "url": "app/locados.html",
          "visibility": { "userIds": [1, 515, 528, 531] },
          "presentation": {
            "mode": "fullscreen"
          }
        },
        {
          "id": "gi-chamados",
          "title": "Chamados",
          "icon": "icon-far-list",
          "url": "app/chamados.html",
          "visibility": { "userIds": [1, 515, 528, 531] },
          "presentation": {
            "mode": "fullscreen"
          }
        },
        {
          "id": "gi-prestadores",
          "title": "Prestadores",
          "icon": "icon-far-user",
          "url": "app/prestadores.html",
          "visibility": { "userIds": [1, 515, 528, 531] },
          "presentation": {
            "mode": "fullscreen"
          }
        },
        {
          "id": "gi-campos",
          "title": "Campos",
          "icon": "icon-far-list",
          "url": "app/campos.html",
          "presentation": {
            "mode": "fullscreen"
          }
        },
        {
          "id": "gi-historico",
          "title": "Histórico",
          "icon": "icon-far-clock",
          "url": "app/historico.html",
          "presentation": {
            "mode": "fullscreen"
          }
        },
        {
          "id": "gi-config",
          "title": "Configurações",
          "icon": "icon-far-gear",
          "url": "app/config.html",
          "presentation": {
            "mode": "fullscreen"
          }
        }
      ]
    },
    {
      "id": "gi-cockpit",
      "type": "chatPanel",
      "title": "Manutenção",
      "url": "app/painel.html",
      "icon": "app/icone-casa.svg",
      "visibility": {
        "userTypes": [0, 1, 2]
      }
    }
  ],
  "icon": "app/icone-casa.svg"
}
